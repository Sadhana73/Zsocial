pan></td><td><span class="stat stat-yes"><i class="dot"></i>Yes</span></td><td><span class="stat stat-no"><i class="dot"></i>No</span></td><td><span class="stat stat-no"><i class="dot"></i>No</span><span class="cell-rest">GMB is not in Sprout's Listening networks list</span></td><td><span class="stat stat-yes"><i class="dot"></i>Yes</span><span class="cell-rest">April 2026 (GMB reviews in Hootsuite Inbox, filterable by star rating)</span></td></tr></tbody>
